{
  "name": "fomo-tradingbot",
  "version": "1.9.0",
  "private": true,
  "description": "Copy-trade pump.fun traders on Solana. Desktop app + 24/7 mode.",
  "license": "MIT",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/index.js",
    "build:server": "node scripts/build-server.js",
    "build:desktop": "electron-builder --win nsis --publish never",
    "build": "npm run build:server && npm run build:desktop",
    "test": "node scripts/selftest.js"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "electron-updater": "^6.8.9",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "rcedit": "^4.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "utf-8-validate": false,
    "bufferutil": false
  },
  "author": "AutoPump",
  "homepage": "https://github.com/rimidalvsulrod/fomo-tradingbot",
  "build": {
    "appId": "com.fomotradingbot.desktop",
    "productName": "AutoPump",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "desktop/**",
      "engine/**",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json",
      "!**/*.map",
      "!node_modules/bufferutil/**",
      "!node_modules/utf-8-validate/**"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "compression": "normal",
    "npmRebuild": false,
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AutoPump",
      "artifactName": "AutoPump-Setup.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rimidalvsulrod",
        "repo": "fomo-tradingbot",
        "releaseType": "release"
      }
    ]
  }
}
