{
  "cleanUrls": true,
  "headers": [
    { "source": "/downloads/(.*)", "headers": [
      { "key": "Content-Disposition", "value": "attachment" },
      { "key": "Cache-Control", "value": "public, max-age=300" }
    ] },
    { "source": "/img/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400" } ] }
  ]
}
